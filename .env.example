# MinIO (Object Storage S3 local)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=iot-datalake

# MongoDB (Catalogo flexivel)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=iot_catalog

# Redis (Estado rapido e cache com TTL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Cassandra (Series temporais)
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=iot_timeseries

# Neo4j (Topologia e dependencias em grafo)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=iot_neo4j_pass
